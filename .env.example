# ── PatternPulse AI environment configuration ────────────────────────────────
# Copy to .env and fill in values. NEVER commit the real .env file.

# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=development                # development | production
APP_NAME=PatternPulse AI
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default dev). For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/patternpulse
DATABASE_URL=sqlite:///./data/patternpulse.db

# ── Backend ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Groq (PulseAI assistant) ────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=
# Any current Groq chat model; the assistant falls back through a small list
# if the configured name is no longer served.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Market data providers (optional, future) ────────────────────────────────
# Currently yfinance needs no key.
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
POLYGON_API_KEY=
BINANCE_API_KEY=
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

# ── Optional infrastructure ─────────────────────────────────────────────────
REDIS_URL=                         # empty => in-process scheduler + SQLite queue
MLFLOW_TRACKING_URI=               # empty => local JSON experiment tracker only
